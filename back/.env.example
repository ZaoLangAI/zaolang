APP_ENV=local
APP_VERSION=0.0.0-dev
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql+psycopg://zaolang:zaolang@localhost:5433/zaolang
TEST_DATABASE_URL=postgresql+psycopg://zaolang:zaolang@localhost:5433/zaolang_test
REDIS_URL=redis://localhost:6380/0

# HS256 needs >= 32 bytes. These are local placeholders — rotate before any
# non-local deployment (e.g. `python -c 'import secrets; print(secrets.token_urlsafe(32))'`).
JWT_SECRET=dev-only-change-me-jwt-secret-please-rotate
ADMIN_JWT_SECRET=dev-only-change-me-admin-jwt-secret-rotate
MCP_JWT_SECRET=dev-only-change-me-mcp-jwt-secret-please-rotate
PAYMENT_WEBHOOK_SECRET=dev-only-change-me-webhook

# "minio" (default, local/self-hosted) or "tencent_cos" (managed). Switching
# is config-only — no code change — but requires the matching block below to
# be filled in.
STORAGE_BACKEND=minio

S3_ENDPOINT_URL=http://localhost:9000
# Browser-facing signed URLs. Keep localhost in local/dev — a NIC IP will
# break as soon as DHCP or Wi-Fi assigns a new address (SigV4 Host + Next
# image optimiser allowlist both bind the hostname).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zaolang-media
S3_ACCESS_KEY=zaolang
S3_SECRET_KEY=zaolang-secret

# Tencent COS — only read when STORAGE_BACKEND=tencent_cos.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
# COS bucket names carry a -<APPID> suffix, e.g. zaolang-media-1250000000.
COS_BUCKET=
# Public/CDN domain for presigned URLs, if different from the region
# endpoint COS_REGION derives (e.g. a custom domain bound in the COS
# console). Leave blank to use the region endpoint directly.
COS_PUBLIC_ENDPOINT_URL=

# The LLM gateway always calls the real, admin-configured endpoint — there is
# no mode switch any more. Endpoint URLs, keys, timeouts and retry counts are
# not read from here at runtime either; they live in the database
# (`llm_providers` platform config, managed at /admin/models). The two
# variables below are read once by `make seed` only, to bootstrap a default
# endpoint for local development so you are not forced to open the admin
# console before the first call can succeed.
LLM_BASE_URL=https://aihubmix.com/v1
LLM_API_KEY=

# Comma separated. `localhost` and `127.0.0.1` are different origins to a
# browser, and 3100 is the port the Playwright suites serve the build from.
# Local media signing stays on localhost (`S3_PUBLIC_ENDPOINT_URL` above).
# Do not replace it with a NIC IP — DHCP/Wi-Fi changes invalidate SigV4 and
# Next's image optimiser allowlist.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
LOG_LEVEL=INFO
OTEL_EXPORTER=console
