APP_ENV=local
APP_VERSION=0.0.0-dev
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
SOURCE_REPOSITORY_URL=https://github.com/ZaoLangAI/zaolang

DATABASE_URL=postgresql+psycopg://zaolang:zaolang@localhost:5433/zaolang
TEST_DATABASE_URL=postgresql+psycopg://zaolang:zaolang@localhost:5433/zaolang_test
REDIS_URL=redis://localhost:6380/0

# Rotate these before any non-local deployment.
JWT_SECRET=dev-only-change-me
ADMIN_JWT_SECRET=dev-only-change-me-admin
PAYMENT_WEBHOOK_SECRET=dev-only-change-me-webhook

S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zaolang-media
S3_ACCESS_KEY=zaolang
S3_SECRET_KEY=zaolang-secret

# LLM gateway: openai_compatible | stub | auto
# Tests and CI always force `stub` regardless of this value.
LLM_MODE=auto
LLM_BASE_URL=https://aihubmix.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Comma separated. `localhost` and `127.0.0.1` are different origins to a
# browser, and 3100 is the port the Playwright suites serve the build from.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
LOG_LEVEL=INFO
OTEL_EXPORTER=console
