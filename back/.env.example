APP_ENV=local
APP_VERSION=0.0.0-dev
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
SOURCE_REPOSITORY_URL=https://github.com/ZaoLangAI/zaolang

DATABASE_URL=postgresql+psycopg://zaolang:zaolang@localhost:5433/zaolang
TEST_DATABASE_URL=postgresql+psycopg://zaolang:zaolang@localhost:5433/zaolang_test
REDIS_URL=redis://localhost:6380/0

# HS256 needs >= 32 bytes. These are local placeholders — rotate before any
# non-local deployment (e.g. `python -c 'import secrets; print(secrets.token_urlsafe(32))'`).
JWT_SECRET=k9Yxvz5CCVmGk9OKwnnBF6VfsWs5VS8r21kmQZ9DSsc
ADMIN_JWT_SECRET=dbTYs3wmf9v5Hc6ZJwLivNUAA0t1NpX4b_eLZX53G5E
PAYMENT_WEBHOOK_SECRET=dev-only-change-me-webhook

S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zaolang-media
S3_ACCESS_KEY=zaolang
S3_SECRET_KEY=zaolang-secret

# LLM gateway operating mode: openai_compatible | stub | auto
# Tests and CI always force `stub` regardless of this value. Endpoint URLs,
# keys, timeouts and retry counts are no longer read from here at runtime —
# they live in the database (`llm_providers` platform config, managed at
# /admin/models). The two variables below are read once by `make seed`
# only, to bootstrap a default endpoint for local development.
LLM_MODE=auto
LLM_BASE_URL=https://aihubmix.com/v1
LLM_API_KEY=

# Comma separated. `localhost` and `127.0.0.1` are different origins to a
# browser, and 3100 is the port the Playwright suites serve the build from.
# For trusted-LAN access, also add the exact Web origin, for example
# `http://192.168.1.10:3000`, and use that host for API_BASE_URL,
# WEB_BASE_URL and S3_PUBLIC_ENDPOINT_URL.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
LOG_LEVEL=INFO
OTEL_EXPORTER=console
