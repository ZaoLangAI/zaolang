# Local container ports. Non-default host ports avoid clashing with any
# Postgres/Redis you already run.
POSTGRES_USER=zaolang
POSTGRES_PASSWORD=zaolang
POSTGRES_DB=zaolang
POSTGRES_PORT=5433

REDIS_PORT=6380
# Cap so a Redis outage becomes "graceful eviction of TTL'd keys" instead of
# "every write errors once the container hits its cgroup memory limit."
REDIS_MAXMEMORY=256mb

MINIO_ROOT_USER=zaolang
MINIO_ROOT_PASSWORD=zaolang-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=zaolang-media
