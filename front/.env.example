# Server-side base URL used by React Server Components.
API_INTERNAL_URL=http://localhost:3001
# Browser-visible base URL used by client components and SSE.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Comma-separated hostnames allowed to use Next.js development assets/HMR.
# Leave empty for local `localhost` development.
NEXT_ALLOWED_DEV_ORIGINS=
APP_VERSION=0.0.0-dev

# The local MinIO container serves media from a private address, which Next 16
# blocks for its image optimiser by default. Never set this in production.
ALLOW_LOCAL_IMAGE_HOSTS=1
# Leave empty. next.config.ts already allowlists localhost:9000 and 127.0.0.1:9000.
# Do not put a DHCP-assigned NIC IP here — it will break as soon as the address changes.
LOCAL_MEDIA_HOST=
