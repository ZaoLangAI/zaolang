# Server-side base URL used by React Server Components.
API_INTERNAL_URL=http://localhost:8000
# Browser-visible base URL used by client components and SSE.
NEXT_PUBLIC_API_URL=http://localhost:8000
# For trusted-LAN access, set this and LOCAL_MEDIA_HOST to the server LAN IP.
# NEXT_PUBLIC_API_URL=http://192.168.1.10:8000
# Comma-separated hostnames or IPs allowed to use Next.js development assets/HMR.
NEXT_ALLOWED_DEV_ORIGINS=
SOURCE_REPOSITORY_URL=https://github.com/ZaoLangAI/zaolang
APP_VERSION=0.0.0-dev

# The local MinIO container serves media from a private address, which Next 16
# blocks for its image optimiser by default. Never set this in production.
ALLOW_LOCAL_IMAGE_HOSTS=1
LOCAL_MEDIA_HOST=
