{
  "name": "zaolang-front",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../back/openapi.json -o src/lib/api/schema.d.ts",
    "check:messages": "node scripts/check-messages.mjs && node scripts/check-message-usage.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y --project=a11y-mobile",
    "qa:visual": "playwright test --project=visual-qa"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@mdxeditor/editor": "^4.3.0",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@xyflow/react": "^12.11.2",
    "animejs": "^4.5.0",
    "mediabunny": "1.29.1",
    "next": "16.3.6",
    "next-intl": "^4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "^4.3.2"
    }
  }
}
