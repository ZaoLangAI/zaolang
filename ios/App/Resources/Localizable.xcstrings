    "assetWorkspace.orbitSource": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The angles are drawn from the {source}; unseen parts are inferred, so results start as candidates."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{source}から選んだアングルを描きます。見えない部分は推測のため、結果はまず候補になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从{source}画出所选机位；看不见的部分由模型推测，生成结果先作为候选。"
          }
        }
      }
    },
