    "collectionPage.deleteCollectionConfirmBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The collection and its saved links are removed; the works themselves are unaffected. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクションと保存された関連付けが削除されます。作品自体には影響しません。元に戻せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分组内的收藏关系会一并清除，作品本身不受影响。此操作不可恢复。"
          }
        }
      }
    },
