    "props.priceHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 means free. Once shared, others can find and use it on the skill plaza; paid ones are unlocked with credits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0 は無料です。共有するとスキルマーケットで他の人が発見・利用できます（有料はクレジットで解除）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0 为免费。分享后其他人可在技能广场发现并使用，付费需先用积分解锁。"
          }
        }
      }
    },
