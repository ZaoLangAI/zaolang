          "stringUnit": {
            "state": "translated",
            "value": "Front is at the bottom; filled = approved, dashed = has candidates. Up to 8 angles, one image each."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下が正面。塗り=確定、破線=候補あり。一度に最大 8 アングル、各 1 枚。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下方为正面；实心=已定稿，虚线=有候选。一次最多 8 个机位，每个机位一张图。"
