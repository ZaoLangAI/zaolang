    "remixPage.promptPlaceholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the tide and the ring, turn the sky the deep blue before a storm, push the camera slowly forward, add fine ripples on the water."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "潮汐と環状遺跡は残し、空を嵐の前の深い青に。カメラはゆっくり前進し、水面に細かな波紋を加える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留潮汐与环形遗迹，让天空转为暴雨将至的深蓝色；镜头缓慢向前推进，水面出现细微涟漪。"
          }
        }
