          }
        }
      }
    },
    "iosCreate.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the intent. ZaoLang arranges the assets, safety, models and quality pass."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意図を伝えるだけで、素材・安全・モデル・品質の流れは造浪が整えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需表达创作意图，造浪会为你安排素材、安全、模型和质量流程。"
          }
        }
      }
    },
    "iosOnboarding.getStarted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get started"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじめる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始使用"
          }
        }
      }
    },
    "iosOnboarding.next": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次へ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一步"
          }
        }
      }
    },
    "iosOnboarding.page1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every version you publish carries its source, its license and the credit chain behind it — see exactly where a work came from."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開したバージョンには出典・ライセンス・分配のつながりが記録され、作品がどこから来たのか創作系譜図でひと目でわかります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你发布的每个版本都带着来源、许可协议与分成链条——创作链图谱让你看清一个作品从何而来。"
          }
        }
      }
    },
    "iosOnboarding.page1Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every remix keeps its lineage"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リミックスのたびに創作の系譜が残る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次二创都留下创作链"
          }
        }
      }
    },
    "iosOnboarding.page2Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The smart gateway routes your request across open and paid models automatically, so you always get the best result for the credits you spend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートゲートウェイがオープンモデルと有料モデルの間で自動的にルーティングし、使ったクレジットを最大限に活かします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能网关会在开源与付费模型之间自动路由，让你花的每一笔积分都用在刀刃上。"
          }
        }
      }
    },
    "iosOnboarding.page2Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One prompt, the right model"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとことで、最適なモデルへ自動ルーティング"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一句话，交给智能网关选对模型"
          }
        }
      }
    },
    "iosOnboarding.page3Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse the community's inspiration wall, start from a work you love, and publish your own version in a few taps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インスピレーションウォールを眺めて、好きな作品から始めて、数タップで自分のバージョンを公開できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
