    "assetVariants.fillHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A complete look has an identity portrait, a front sheet, four turnaround angles (right, back, left, front-right) and one grid of everyday expressions. What is missing is generated in steps; each step starts on its own when the previous one finishes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全な衣装はメイク写真・正面の設定画・4 つの回転アングル（右・背面・左・右斜め前）・基本表情のグリッド 1 枚で構成されます。不足分を段階的に生成し、各段階が終わると次が自動で始まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一套完整造型包括定妆照、正面设定图、四个转面机位（右侧、背面、左侧、右前侧）和一张基础表情宫格。缺的部分会分几步依次生成，每步完成后自动开始下一步。"
          }
        }
      }
    },
    "assetVariants.fillInsufficient": {
