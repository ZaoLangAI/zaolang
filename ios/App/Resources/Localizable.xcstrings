    "assetWorkspace.panorama.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to look around and scroll to zoom. A cut is saved as this variant's shot for the current camera angle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで向きを変え、スクロールでズームします。切り出した画像は、現在のアングルでこのバリエーションのショットとして保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动画面调整朝向，滚轮缩放景别；截取的画面按当前机位存为这个变体的机位图。"
          }
        }
      }
    },
    "assetWorkspace.panorama.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuts keep the panorama's distortion. Use Refine to redraw one as a single shot from that angle (the result starts as a candidate). If the angle already has an approved image, the cut also starts as a candidate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り出した画像にはパノラマの歪みが残ります。「仕上げ」でそのアングルの単一ショットとして描き直せます（結果はまず候補になります）。そのアングルに確定済みの画像がある場合、切り出した画像も候補になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图带有全景畸变，可用「精修」按此机位重绘成单镜头画面（结果先作为候选）。机位已有定稿图时，截图也先作为候选。"
          }
        }
      }
    },
    "assetWorkspace.panorama.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading panorama…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パノラマを読み込み中…"
