    "assetWorkspace.panorama.slotHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generates one 360° panorama (2:1 equirectangular), using the approved main image as reference when there is one. A panorama is for viewing and cutting camera angles; it is never used as a reference image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "360° パノラマ（2:1 正距円筒図法）を1枚生成します。確定済みのメイン画像があれば参考にします。パノラマは閲覧とカメラアングルの切り出し用で、参考画像には使われません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成一张 360° 全景图（2:1 等距柱状投影）；已有定稿主图时以它为参考。全景图用来查看和截取机位，不会作为参考图。"
          }
        }
      }
    },
