    "remixPage.presets.expressionsActiveHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generates one sheet with {count} expressions. Not added to the character library by default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} 種類の表情を含む1枚を生成します。既定ではキャラクターライブラリに追加しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将生成一张包含 {count} 种表情的合集图，默认不加入角色库。"
          }
        }
      }
    },
    "remixPage.presets.expressionsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick expressions to generate one grid of this character's faces from their sheet, instead of a character sheet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表情を選ぶと、このキャラクターの設定画を参考に表情グリッドを1枚生成します（設定画ではありません）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择表情后，将以该角色的设定图为参考，生成一张多表情宫格图，而不是设定图。"
          }
        }
      }
    },
    "remixPage.presets.expressionsLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expression sheet (multi-select)"
