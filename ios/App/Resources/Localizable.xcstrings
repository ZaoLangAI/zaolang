    "remixPage.musicDirectHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the music or sound effect"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽や効果音を記述"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述音乐或音效"
          }
        }
      }
    },
    "remixPage.musicDirectHintBodyMusic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the style, mood, tempo and main instruments, e.g. \"a cheerful ukulele tune for a feel-good daily-life short drama\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタイル、雰囲気、テンポ、主な楽器を記述してください。例：「ほのぼの系ショートドラマに合う、軽快なウクレレの小曲」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以描述风格、情绪、节奏与主要乐器，例如“轻快的尤克里里小调，适合治愈系日常短剧”。"
          }
        }
      }
    },
    "remixPage.musicDirectHintBodySfx": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the specific sound-effect scene, e.g. \"a wooden door creaking open, with a faint echo\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "具体的な効果音のシーンを記述してください。例：「木のドアが軋みながら開く音、微かな残響を伴う」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述具体的音效场景，例如“开门时木门吱呀的摩擦声，伴随轻微回响”。"
          }
        }
      }
    },
    "remixPage.musicDurationHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1-22 seconds; leave blank to let the model decide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1〜22秒。空欄の場合はモデルが長さを決定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1-22 秒；留空则由模型决定时长。"
          }
        }
      }
    },
    "remixPage.musicDurationInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duration must be a whole number of seconds between 1 and 22."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長さは1〜22の整数秒で指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时长必须为 1-22 之间的整数秒。"
          }
        }
      }
    },
    "remixPage.musicDurationLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
