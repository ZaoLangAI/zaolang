      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine lighting, weather, state and period; each combination makes one image filed under its variant. Combinations that already have an approved master plate or waiting candidates are skipped."
