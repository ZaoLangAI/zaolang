    "characters.publishCharacterHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing submits this character for review. Once approved, other creators can find and use it in the skill plaza (and unlock it with credits, if priced)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有すると審査に提出されます。承認されると他の制作者がスキル広場でこのキャラクターを見つけて利用できるようになります（価格を設定していればクレジットで解除できます）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享后该角色会提交审核，通过后其他创作者可以在技能广场看到并使用（如设置了积分价格，还可以购买解锁）。"
          }
        }
      }
    },
    "characters.referenceHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Front, side, and back views, used to keep this character's look consistent in future generations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正面・側面・背面の3方向。今後の生成でこのキャラクターの見た目を保つために使われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定正面、侧面、背面三个角度，将用于后续生成时保持人物样貌一致。"
          }
        }
      }
    },
