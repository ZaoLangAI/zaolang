    "remixPage.presets.portraitHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The character's identity anchor — once approved, every look's sheet keeps this face."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャラクターの基準となる顔です。確定後、すべての衣装の設定画がこの顔に合わせられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定妆照是这个角色的身份锚点，定稿后所有造型的设定图都以它的脸为准。"
          }
        }
      }
    },
    "remixPage.presets.portraitLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identity portrait (front, head and shoulders, neutral)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メイク写真（正面・胸から上・無表情）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成定妆照（正面头肩、中性表情）"
          }
        }
      }
    },
    "remixPage.presets.sceneHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lighting, weather, state and period are added to the brief; with a master image, structure and camera stay fixed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光・天候・状態・時代が生成指示に加わります。メイン画像がある場合は構造とカメラを固定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光照、天气、状态与时期会写入生成要求；已有主图时以主图为基准，保持结构与机位不变。"
          }
        }
      }
    },
