    "iosCreate.remixTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remix a work"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作品から二次創作"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
