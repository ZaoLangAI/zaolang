    "createPage.startHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick whichever is closest to your goal; assets and parameters stay editable."
          }
        },
        "ja": {
