    "remixPage.continuityApplied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-linked to the previous shot's last frame as this shot's opening frame, so the cut stays continuous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前のショットの最後のフレームを自動的に本ショットの最初のフレームとして接続し、カットのつながりを保っています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已自动衔接上一镜头的结尾画面作为本镜头的开头，保证画面衔接。"
          }
        }
      }
    },
    "remixPage.continuityApplying": {
      "extractionState": "manual",
