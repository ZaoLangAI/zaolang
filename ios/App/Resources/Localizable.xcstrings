    "props.publishPropHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing sends this prop for review. Once approved, other creators can find and use it on the skill plaza (and buy it if you set a credit price)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有すると審査に送られます。承認後、他のクリエイターがスキルマーケットで見つけて利用できます（クレジット価格を設定した場合は購入も可能）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享后该道具会提交审核，通过后其他创作者可以在技能广场看到并使用（如设置了积分价格，还可以购买解锁）。"
          }
        }
      }
