    "createPage.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the intent. ZaoLang arranges the assets, safety, models and quality pass."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意図を伝えるだけで、素材・安全・モデル・品質の流れは造浪が整えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需表达创作意图，造浪会为你安排素材、安全、模型和质量流程。"
          }
        }
      }
