    "learnPage.safetyBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View only by default: nobody can remix your work until you open it. Source, author and licence snapshot travel with the lineage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定は閲覧のみ。作者が開放するまで誰も二次創作できません。出典・作者・ライセンススナップショットは創作チェーンとともに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认仅展示：只有作者主动开启后，其他用户才能继续二创。来源、作者和许可快照会随创作链保留。"
          }
        }
      }
    },
