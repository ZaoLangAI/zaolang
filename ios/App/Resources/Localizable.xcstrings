    "characters.portraitConsentLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I confirm I have the right to publicly share this character's likeness, and understand others may use it in their own creations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキャラクターの肖像を公開共有する権利があることを確認し、他の人がそれを使って創作する可能性があることを理解しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我确认拥有公开分享这个角色形象的权利，并了解他人可能会套用它进行创作。"
          }
        }
      }
    },
    "characters.priceHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 is free. Once shared, others can discover and use it from the skill marketplace; paid unlocks spend credits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0 は無料です。共有すると他の人がスキルマーケットで発見・利用できます。有料はクレジットで解除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0 为免费。分享后其他人可在技能广场发现并使用，付费需先用积分解锁。"
          }
        }
      }
    },
    "characters.priceLabel": {
