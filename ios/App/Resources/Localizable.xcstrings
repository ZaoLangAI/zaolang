    "remixPage.consentConfirmPortrait": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I confirm the person shown has personally agreed to their likeness being used for generation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写っている本人から、肖像を生成に利用することについて個別の同意を得ていることを確認します。"
          }
