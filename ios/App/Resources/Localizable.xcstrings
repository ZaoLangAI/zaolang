    "collectionPage.purgeWorkConfirmBodyReferenced": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This work has downstream remixes. Its lineage slot stays as a placeholder, but cover and output files will be removed. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この作品には二次創作があります。創作チェーン上の位置はプレースホルダーとして残り、カバーと出力ファイルは削除されます。元に戻せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该作品有下游二创。创作链会保留占位，封面和成片文件会被清除。此操作不可恢复。"
          }
        }
      }
    },
