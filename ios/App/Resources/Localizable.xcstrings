    "billingPage.spendLimitHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap the credits you spend on generation each month; a batch or canvas run stops at the cap instead of draining your balance. Leave empty for no cap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成に使うクレジットの月間上限を設定します。一括生成やキャンバスの実行は上限で止まり、残高を一度に使い切りません。空欄なら上限なし。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给自己设一个每月用于生成的积分上限；批量生成或画布任务到了上限会停下，不会把余额一次用光。留空表示不设上限。"
          }
        }
      }
    },
