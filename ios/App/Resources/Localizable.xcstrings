      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved as a separate outfit for this character — it won't replace other outfits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキャラクターの別衣装として保存され、他の衣装を上書きしません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写后，这张设定图会作为该角色的独立造型保存，不会覆盖其他造型。"
          }
        }
      }
    },
