          "stringUnit": {
            "state": "translated",
            "value": "表情集（複数選択）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表情合集（可多选）"
          }
        }
      }
    },
    "remixPage.presets.groupActiveHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick {min}–{max} values on that dimension. Charged per variant, generated one by one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その項目で {min}〜{max} 個選んでください。バリエーション数で課金し、1枚ずつ生成します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在该维度选择 {min}–{max} 个值；按变体数量计费，逐张生成。"
          }
        }
      }
    },
