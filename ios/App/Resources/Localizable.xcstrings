    "remixPage.modelSelectHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picking a model skips smart routing and uses it directly; if it's unavailable the job fails outright instead of switching to another model."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定するとスマートルーティングをスキップしてそのモデルを直接使用します。利用できない場合はほかのモデルに切り替わらず、そのまま失敗します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指定后将跳过智能路由直接使用该模型；若该模型暂时不可用，任务会直接失败，不会自动切换到其它模型。"
          }
        }
      }
    },
    "remixPage.modelSelectLabel": {
      "extractionState": "manual",
